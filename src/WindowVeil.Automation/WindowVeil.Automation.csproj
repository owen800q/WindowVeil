<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!--
      WPF is enabled ONLY to reference the managed UI Automation client assemblies
      (UIAutomationClient / UIAutomationTypes, namespace System.Windows.Automation), which ship in the
      Microsoft.WindowsDesktop.App (WPF) shared framework. This library creates no WPF UI.
    -->
    <UseWPF>true</UseWPF>
    <RootNamespace>WindowVeil.Automation</RootNamespace>
    <!-- Required by the LibraryImport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>UI Automation locators for WindowVeil: find elements and text ranges of external windows by AutomationId, Name, ControlType or TextPattern, plus an element inspector for visual editors.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WindowVeil.Core\WindowVeil.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WindowVeil.UiTests" />
    <InternalsVisibleTo Include="WindowVeil.UnitTests" />
  </ItemGroup>
</Project>
