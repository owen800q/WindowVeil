<!--
  Application resources are intentionally empty: styles live in Themes/EditorStyles.xaml, merged into the main window,
  so WPF overlay content created on WindowVeil's own dispatcher thread never resolves editor resources.
-->
<Application x:Class="WindowVeil.Editor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose" />
