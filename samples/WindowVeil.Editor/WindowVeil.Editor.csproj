<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WindowVeil.Editor: a visual rule editor for WindowVeil. Pick elements of an external application with a crosshair,
    inspect their UI Automation properties, design rules (locator, appearance, placement, input), preview them live on
    the target and export/import JSON profiles. Everything goes through the public WindowVeil APIs.
    Run it on Windows with "dotnet run" from samples/WindowVeil.Editor.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>WindowVeil.Editor</RootNamespace>
    <AssemblyName>WindowVeil.Editor</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport (GetCursorPos, SetWindowPos) generates blittable marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Visual rule editor for WindowVeil: element picker, UI Automation inspector, rule designer, live preview and JSON profiles.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WindowVeil.Core\WindowVeil.Core.csproj" />
    <ProjectReference Include="..\..\src\WindowVeil.Native\WindowVeil.Native.csproj" />
    <ProjectReference Include="..\..\src\WindowVeil.Automation\WindowVeil.Automation.csproj" />
    <ProjectReference Include="..\..\src\WindowVeil.Tracking\WindowVeil.Tracking.csproj" />
    <ProjectReference Include="..\..\src\WindowVeil.Wpf\WindowVeil.Wpf.csproj" />
    <ProjectReference Include="..\..\src\WindowVeil.Profiles\WindowVeil.Profiles.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
