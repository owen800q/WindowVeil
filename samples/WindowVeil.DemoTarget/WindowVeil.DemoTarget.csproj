<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A deterministic stand-in for "any external application": automated UI Automation tests, demos and benchmarks
    launch it and attach WindowVeil to it. Keep element names, texts and layout stable; tests depend on them.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>WindowVeil.DemoTarget</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
