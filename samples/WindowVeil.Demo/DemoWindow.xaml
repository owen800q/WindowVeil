<Window x:Class="WindowVeil.Demo.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowVeil Demo" Width="720" Height="660" Left="20" Top="120"
        FontFamily="Segoe UI" FontSize="13">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="WindowVeil" FontSize="22" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Foreground="DimGray" Margin="0,2,0,10"
                 Text="Overlays are separate windows drawn above another application. The target is not modified: masked controls still exist and still work." />
      <WrapPanel>
        <Button Content="Launch demo target" Command="{Binding LaunchTargetCommand}" />
        <TextBox Width="160" Margin="0,0,6,6" VerticalContentAlignment="Center" Text="{Binding TargetTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Attach to the window whose title contains this text" />
        <Button Content="Attach" Command="{Binding AttachCommand}" />
        <Button Content="Detach" Command="{Binding DetachCommand}" />
        <Button Content="Export profile..." Command="{Binding ExportCommand}" />
      </WrapPanel>
      <TextBlock Text="{Binding SessionText}" Margin="0,2,0,8" FontWeight="SemiBold" />
    </StackPanel>
    <TextBox DockPanel.Dock="Bottom" Height="110" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
             Text="{Binding LogText, Mode=OneWay}" TextChanged="OnLogChanged" />
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
      <ItemsControl ItemsSource="{Binding Scenarios}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Top" Margin="0,2,8,0" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Description}" Foreground="DimGray" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Status}" Foreground="#1565C0" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
